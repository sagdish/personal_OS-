{
  "name": "personal-os",
  "version": "0.1.0",
  "description": "Your life as plain files, one AI voice that reads them once a day, a page that shows where you stand.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "personal-os": "bin/create.mjs"
  },
  "files": [
    "bin",
    "_system/core",
    "_system/state/.gitkeep",
    "_system/logs/.gitkeep",
    "app/app",
    "app/components",
    "app/lib",
    "app/core.d.ts",
    "app/next-env.d.ts",
    "app/next.config.ts",
    "app/tsconfig.json",
    "app/package.json",
    ".claude",
    ".gitignore",
    "CLAUDE.md",
    "SETUP.md",
    "README.md",
    "LICENSE",
    "install.sh"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "os": "node bin/os.mjs",
    "doctor": "node bin/os.mjs doctor",
    "read": "node bin/os.mjs read"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "yaml": "^2.9.1"
  },
  "keywords": [
    "personal-os",
    "life-os",
    "markdown",
    "claude-code",
    "second-brain"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sagdish/personal_OS.git"
  },
  "homepage": "https://github.com/sagdish/personal_OS#readme",
  "bugs": {
    "url": "https://github.com/sagdish/personal_OS/issues"
  }
}
